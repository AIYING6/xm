  "evaluation": {
    "development_only": true,
    "tape_protocol": "DRTP-STABILIZATION-DEVELOPMENT-V1-TAPE",
    "conditions": 5,
    "episodes_per_condition": 100,
    "endpoint_only": true,
    "forbidden": ["online_evaluation", "checkpoint_promotion", "heldout_input", "automatic_v2", "automatic_confirmation"]
  }
}
